{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["index.tsx", "App.tsx"],
  "project": ["**/*.{ts,tsx}"],
  "ignore": [
    "scripts/**",
    ".claude/**",
    "src/generated/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": [],
  "ignoreDependencies": [
    "puppeteer",
    "@types/adm-zip",
    "adm-zip",
    "exceljs",
    "jscpd"
  ],
  "ignoreBinaries": ["tsx"]
}
