{
  "name": "construction-album-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "gaspm": "dist-cli/index.js"
  },
  "scripts": {
    "dev": "node scripts/ensure-codebase-stats.js && vite",
    "prebuild": "node scripts/ensure-codebase-stats.js",
    "build": "vite build",
    "build:cli": "node -e \"require('child_process').execSync('npx esbuild cli/index.ts --bundle --platform=node --target=node18 --outfile=dist-cli/index.js --format=esm --packages=external', {stdio: 'inherit'})\"",
    "cli": "node dist-cli/index.js",
    "a": "node dist-cli/index.js analyze",
    "aw": "node dist-cli/index.js analyze:web",
    "server": "npm run build:server && node dist-cli/server.js",
    "build:server": "node -e \"require('child_process').execSync('npx esbuild cli/server.ts --bundle --platform=node --target=node18 --outfile=dist-cli/server.js --format=esm --packages=external', {stdio: 'inherit'})\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prompt:test": "npx tsx scripts/prompt-test.ts",
    "prompt:eval": "npx tsx scripts/evaluate.ts",
    "generate:ts": "npx tsx scripts/generate-layout-ts.ts",
    "generate:rs": "npx tsx scripts/generate-layout-rs.ts",
    "generate:js": "npx tsx scripts/generate-layout-js.ts",
    "generate:all": "npm run generate:ts && npm run generate:rs && npm run generate:js",
    "sync:to-rust": "npx tsx scripts/sync-to-rust.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@webcontainer/api": "^1.6.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "lucide-react": "^0.554.0",
    "ora": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "puppeteer": "^24.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.33.5",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-code-sdk": "npm:null@^0.0.48"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.27.2",
    "exceljs": "^4.4.0",
    "jscpd": "^4.0.5",
    "jsdom": "^27.4.0",
    "knip": "^5.78.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  }
}
